   skin/classic/global/arrow/arrow-dn-hov.gif               (../../osx/global/arrow/arrow-dn.gif)
   skin/classic/global/arrow/arrow-dn-sharp.gif             (../../osx/global/arrow/arrow-dn-sharp.gif)
   skin/classic/global/arrow/arrow-down.png                 (../../windows/global/arrow/arrow-down.png)
   skin/classic/global/arrow/arrow-lft.gif                  (../../osx/global/arrow/arrow-lft.gif)
   skin/classic/global/arrow/arrow-lft-dis.gif              (../../osx/global/arrow/arrow-lft-dis.gif)
   skin/classic/global/arrow/arrow-lft-hov.gif              (../../osx/global/arrow/arrow-lft.gif)
   skin/classic/global/arrow/arrow-lft-sharp.gif            (../../osx/global/arrow/arrow-lft-sharp.gif)
   skin/classic/global/arrow/arrow-lft-sharp-end.gif        (../../osx/global/arrow/arrow-lft-sharp-end.gif)
   skin/classic/global/arrow/arrow-rit.gif                  (../../osx/global/arrow/arrow-rit.gif)
   skin/classic/global/arrow/arrow-rit-dis.gif              (../../osx/global/arrow/arrow-rit-dis.gif)
   skin/classic/global/arrow/arrow-rit-hov.gif              (../../osx/global/arrow/arrow-rit.gif)
   skin/classic/global/arrow/arrow-rit-sharp.gif            (../../osx/global/arrow/arrow-rit-sharp.gif)
   skin/classic/global/arrow/arrow-rit-sharp-end.gif        (../../osx/global/arrow/arrow-rit-sharp-end.gif)
   skin/classic/global/arrow/arrow-up.gif                   (../../osx/global/arrow/arrow-up.gif)
   skin/classic/global/arrow/arrow-up-dis.gif               (../../osx/global/arrow/arrow-up-dis.gif)
