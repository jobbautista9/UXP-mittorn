toolkit.jar:
% skin global classic/1.0 %skin/classic/global/
# Inherit from windows, but override wrong/missing styles
*  skin/classic/global/scrollbars.css                    (xulscrollbars.css)
*  skin/classic/global/menu.css                          (menu.css)

# Default faststripe/winstripe arrows looks too small, override it with osx
   skin/classic/global/arrow/arrow-dn.gif                   (../../osx/global/arrow/arrow-dn.gif)
